{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "channel": "preview",
      "distribution": "internal"
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "production",
      "autoIncrement": true
    },
    "personal": {
      "extends": "preview",
      "channel": "personal",
      "env": {
        "PERSONAL_FEATURES": "1",
        "EXPO_PUBLIC_PERSONAL": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
